{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.example/golden-paths/kubernetes-cluster/v1alpha1/intent.schema.json",
  "title": "Intent KubernetesCluster v1alpha1",
  "description": "Platform Amazon EKS cluster. Alpha version: allowed only in dev. Every 'default' is the most conservative choice.",
  "$ref": "https://acme.example/golden-paths/_common/intent-common.schema.json",
  "unevaluatedProperties": false,
  "properties": {
    "apiVersion": {
      "const": "intent.acme.io/v1alpha1"
    },
    "kind": {
      "const": "KubernetesCluster"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kubernetes_version",
        "node_provisioning",
        "node_topology",
        "endpoint_access",
        "node_size"
      ],
      "properties": {
        "kubernetes_version": {
          "description": "Kubernetes version 'major.minor'. No default: it must be verified at runtime against the versions EKS supports (aws-knowledge-guard power).",
          "type": "string",
          "pattern": "^1\\.[0-9]{2}$"
        },
        "node_provisioning": {
          "type": "string",
          "enum": [
            "managed-node-group",
            "auto-mode"
          ],
          "default": "managed-node-group"
        },
        "node_topology": {
          "description": "Placement of the NODES. The control plane always uses subnets in at least two AZs (EKS requirement). 'single-az' reduces costs but binds workloads and EBS volumes to one AZ.",
          "type": "string",
          "enum": [
            "multi-az",
            "single-az"
          ],
          "default": "multi-az"
        },
        "endpoint_access": {
          "type": "string",
          "enum": [
            "private",
            "public-and-private"
          ],
          "default": "private"
        },
        "node_size": {
          "description": "Node profile: instance types and scaling come from the environment's compute/kubernetes-cluster tokens.",
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "default": "small"
        }
      }
    }
  }
}
